# PostgreSQL connection for the owner panel (Vercel compatible hosted PostgreSQL)
DATABASE_URL=
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-long-password', 12))"
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Optional override for the owner-confirmed public WhatsApp contact number.
# International digits only. Current owner-confirmed default: 905402560609
WHATSAPP_ORDER_NUMBER=

# Production origin required for canonical metadata, robots sitemap and sitemap URLs
NEXT_PUBLIC_SITE_URL=
